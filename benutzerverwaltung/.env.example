# Konfiguration der Benutzerverwaltung.
# Kopieren nach .env (oder .env.local) und bei Bedarf anpassen.
# Die DB-Werte passen zu docker-compose.yml.

# --- Datenbank (MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lager
DB_PASSWORD=lager_pw
DB_NAME=lagerverwaltung_benutzer

# --- Login-Token (JWT) ---
# Geheimer Schlüssel zum Signieren der Tokens, mindestens 32 Zeichen.
# Eigenen Wert erzeugen z. B. mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=bitte-ersetzen-durch-einen-langen-zufaelligen-wert-0123456789

# --- CORS ---
# Origins (Frontends der anderen Komponenten), die /api/* im Browser
# aufrufen dürfen. Kommagetrennt, "*" erlaubt alle.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
